-- Function to handle automated typing into the game textbox
local function simulateTyping(word)
    if not word or word == "" then return end
    pcall(function()
        for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if gui:IsA("TextBox") and gui.Visible and gui.Active then
                gui.Text = ""
                task.wait(0.05)
                for i = 1, #word do
                    if not AutoAnswerEnabled then break end
                    gui.Text = string.sub(word, 1, i)
                    task.wait(TypingSpeedDelay)
                end
                break
            end
        end
    end)
end

-- Hook into Network / Client Events for word capture
task.spawn(function()
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
                obj.OnClientEvent:Connect(function(...)
                    local args = {...}
                    for _, arg in ipairs(args) do
                        if type(arg) == "string" and #arg >= 2 and #arg <= 35 then
                            if arg:match("^[%a]+$") then
                                CurrentTargetWord = arg
                                SpellingWordParagraph:SetTitle("Current Active Word")
                                SpellingWordParagraph:SetDesc("Revealed Answer: " .. CurrentTargetWord)
                                
                                if AutoAnswerEnabled then
                                    task.spawn(function()
                                        task.wait(0.1)
                                        simulateTyping(CurrentTargetWord)
                                    end)
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
end)

-- UI Text Monitor Fallback Engine
task.spawn(function()
    while true do
        pcall(function()
            for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextLabel") and gui.Visible then
                    local text = gui.Text
                    if text:lower():find("word:") or text:lower():find("spell:") or text:lower():find("answer:") then
                        local parts = text:split(":")
                        if parts[2] then
                            local cleanWord = parts[2]:gsub("%s+", "")
                            if cleanWord ~= "" and cleanWord ~= CurrentTargetWord and #cleanWord > 1 then
                                CurrentTargetWord = cleanWord
                                SpellingWordParagraph:SetTitle("Current Active Word")
                                SpellingWordParagraph:SetDesc("Revealed Answer: " .. CurrentTargetWord)
                                
                                if AutoAnswerEnabled then
                                    task.spawn(function()
                                        task.wait(0.1)
                                        simulateTyping(CurrentTargetWord)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end)
        task.wait(0.3)
    end
end)

