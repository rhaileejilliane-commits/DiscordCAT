local windowDragging, windowDragStart, windowStartPos
titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		windowDragging = true
		windowDragStart = input.Position
		windowStartPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then windowDragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if windowDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - windowDragStart
		mainFrame.Position = UDim2.new(windowStartPos.X.Scale, windowStartPos.X.Offset + delta.X, windowStartPos.Y.Scale, windowStartPos.Y.Offset + delta.Y)
	end
end)

local dragging, dragInput, dragStart, startPos
local isClick = true
floatingContainer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		isClick = true
		dragStart = input.Position
		startPos = floatingContainer.Position
		
		TweenService:Create(floatingContainer, TweenInfo.new(0.2), {Size = UDim2.new(0, 38, 0, 38)}):Play()
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				TweenService:Create(floatingContainer, TweenInfo.new(0.2), {Size = UDim2.new(0, 42, 0, 42)}):Play()
			end
		end)
	end
end)

floatingContainer.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then isClick = false end
		floatingContainer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local function minimizeGui()
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local shrinkTween = TweenService:Create(mainFrame, tweenInfo, {
		Size = UDim2.new(0, 0, 0, 0),
		Position = floatingContainer.Position + UDim2.new(0, 21, 0, 21)
	})
	shrinkTween:Play()
	shrinkTween.Completed:Wait()
	mainFrame.Visible = false
	floatingContainer.Visible = true
	fovCircle.Visible = false
end

local function expandGui()
	if not isClick then return end
	floatingContainer.Visible = false
	mainFrame.Visible = true
	
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.Position = floatingContainer.Position + UDim2.new(0, 21, 0, 21)
	
	local expandTween = TweenService:Create(mainFrame, tweenInfo, {
		Size = UDim2.new(0, 380, 0, 420),
		Position = UDim2.new(0.5, -190, 0.5, -210)
	})
	expandTween:Play()
	fovCircle.Visible = getAimbotState()
end

closeButton.MouseButton1Click:Connect(minimizeGui)
floatingContainer.MouseButton1Click:Connect(expandGui)

