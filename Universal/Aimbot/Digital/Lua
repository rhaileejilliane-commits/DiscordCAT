	local aimbotEnabled = getAimbotState()
	fovCircle.Visible = aimbotEnabled
	
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	if aimbotEnabled then
		fovCircle.Position = screenCenter
		fovCircle.Radius = fovRadius * 12
	end
	
	local closestTarget = nil
	local shortestDist = math.huge
	
	-- Calculate green fade effect dynamically using tick time
	local fadeFactor = (math.sin(tick() * 4) + 1) / 2 -- Ranges from 0 to 1 smoothly
	local greenFadeColor = Color3.fromRGB(0, math.floor(100 + (fadeFactor * 155)), 0)
	
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local passTeam = true
			if getTeamCheck() and otherPlayer.Team and player.Team and otherPlayer.Team == player.Team then
				passTeam = false
			end
			
			local drawings = espDrawings[otherPlayer]
			local character = otherPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			local head = character and character:FindFirstChild("Head")
			
			local shouldShowEsp = passTeam and character and humanoid and humanoid.Health > 0 and rootPart and head
			
			if shouldShowEsp then
				local vector, onScreen = camera:WorldToViewportPoint(rootPart.Position)
				if onScreen then
					local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
					local legPos = camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
					
					local height = math.abs(headPos.Y - legPos.Y)
					local width = height / 2
					local boxPosition = Vector2.new(headPos.X - width / 2, headPos.Y)
					local boxSize = Vector2.new(width, height)
					
					-- ESP Box
					if getEspBoxState() then
						drawings.Box.Visible = true
						drawings.Box.Size = boxSize
						drawings.Box.Position = boxPosition
						drawings.Box.Color = greenFadeColor
					else
						drawings.Box.Visible = false
					end
					
					-- ESP Tracers
					if getEspTracerState() then
						drawings.Tracer.Visible = true
						drawings.Tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
						drawings.Tracer.To = Vector2.new(rootPart.Position.X, legPos.Y)
						drawings.Tracer.Color = greenFadeColor
					else
						drawings.Tracer.Visible = false
					end
					
					-- ESP Names
					if getEspNameState() then
						drawings.Name.Visible = true
						drawings.Name.Text = otherPlayer.Name
						drawings.Name.Position = Vector2.new(headPos.X, headPos.Y - 18)
						drawings.Name.Color = greenFadeColor
					else
						drawings.Name.Visible = false
					end
					
					-- ESP Health
					if getEspHealthState() then
						drawings.Health.Visible = true
						drawings.Health.Text = "HP: " .. math.floor(humanoid.Health)
						drawings.Health.Position = Vector2.new(boxPosition.X + boxSize.X + 22, boxPosition.Y + (boxSize.Y / 2))
						drawings.Health.Color = greenFadeColor
					else
						drawings.Health.Visible = false
					end
				else
					if drawings then
						drawings.Box.Visible = false
						drawings.Tracer.Visible = false
						drawings.Name.Visible = false
						drawings.Health.Visible = false
					end
				end
			else
				if drawings then
					drawings.Box.Visible = false
					drawings.Tracer.Visible = false
					drawings.Name.Visible = false
					drawings.Health.Visible = false
				end
			end
			
			-- Aimbot selection logic
			if aimbotEnabled and passTeam and character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local targetPart = head or rootPart
				
				if humanoid and humanoid.Health > 0 and targetPart then
					local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
					
					if onScreen then
						local screenVector = Vector2.new(screenPos.X, screenPos.Y)
						local dist = (screenVector - screenCenter).Magnitude
						
						if dist <= (fovRadius * 12) and dist < shortestDist then
							if isVisible(targetPart) then
								shortestDist = dist
								closestTarget = targetPart
							end
						end
					end
				end
			end
		end
	end
	
	if aimbotEnabled and closestTarget then
		local targetCFrame = CFrame.new(camera.CFrame.Position, closestTarget.Position)
		if aimbotMode == 1 then
			-- Mode 1: Smooth aimbot
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(dt * smoothness * 5, 0, 1))
		else
			-- Mode 2: Original / Snappy (Not clearly smooth)
			camera.CFrame = targetCFrame
		end
	end
end)

